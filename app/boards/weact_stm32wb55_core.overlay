/*
 * Provisório até a etapa 8: o botão BOOT (PH3) faz o papel do detector de sopro
 * e o sensor é lido em PA0 (ADC1_IN5, já roteado pela placa). Sem pinos de
 * aquecedor e inibidor, esses módulos só registram em LOG.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/ {
	zephyr,user {
		io-channels = <&adc1 5>;
		detector-sopro-gpios = <&gpioh 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
	};
};
