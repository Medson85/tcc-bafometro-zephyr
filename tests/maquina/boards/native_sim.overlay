/*
 * native_sim: GPIO e ADC emulados. O roteiro de simulação e os testes acionam
 * o detector com gpio_emul_input_set() e definem a tensão sobre RL com
 * adc_emul_const_value_set().
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

&adc0 {
	ref-internal-mv = <3300>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/ {
	zephyr,user {
		io-channels = <&adc0 0>;
		detector-sopro-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		aquecimento2v-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		aquecimento0v9-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		inibidor-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
	};
};
